# Required — contact form delivery. Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Recommended — drives canonical, OG image, sitemap, and JSON-LD URLs.
# Set to your production origin, no trailing slash. e.g. https://mohebsaeed.dev
NEXT_PUBLIC_SITE_URL=

# Optional — strict, cross-instance rate limiting for the contact form.
# Create a free database at https://console.upstash.com (Redis, free tier, no
# card) and paste its REST URL + token here. If left blank, the form falls back
# to a per-instance in-memory limiter automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
